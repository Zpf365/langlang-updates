<view class="page">
  <view class="card">
    <view class="title">澜琅买家助手</view>
    <view class="subtitle">电脑负责商品筛选和任务管理，手机负责微信身份确认与原生小店操作。</view>
  </view>
  <view class="card">
    <view class="subtitle">{{message}}</view>
    <button class="primary" bindtap="scan">扫描电脑绑定码</button>
    <button wx:if="{{ticket}}" class="secondary" bindtap="continueBind">继续本次绑定</button>
  </view>
</view>
