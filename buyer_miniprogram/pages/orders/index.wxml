<view class="page">
  <view class="card"><view class="title">订单查询</view><view class="subtitle">只显示电脑端通过官方商家订单接口核验的订单。</view></view>
  <view class="empty" wx:if="{{!orders.length}}">暂无可核验订单</view>
  <view class="card" wx:for="{{orders}}" wx:key="match_id">
    <view class="row"><text>{{item.platform_order_id}}</text><text class="status">{{item.match_status}}</text></view>
    <view class="muted">¥{{item.total_amount_cents / 100}} · {{item.verified_at}}</view>
    <button class="secondary" data-id="{{item.platform_order_id}}" bindtap="detail">打开微信小店订单详情</button>
  </view>
</view>
