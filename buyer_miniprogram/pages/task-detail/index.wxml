<view class="page" wx:if="{{current}}">
  <view class="card">
    <view class="row">
      <view class="title">商品 {{index + 1}} / {{items.length}}</view>
      <view class="status">{{current.status}}</view>
    </view>
    <view class="subtitle">{{current.title}}</view>
    <view class="muted">SKU：{{current.sku_id}} · 数量：{{current.quantity}}</view>
    <view class="price">¥{{current.unit_price_cents / 100}}</view>
  </view>
  <view class="card">
    <store-product
      wx:if="{{shopAppId}}"
      appid="{{shopAppId}}"
      product-id="{{current.product_id}}"
    />
    <view wx:else class="subtitle">微信小店 AppID 尚未配置，商品组件不可用。</view>
    <view class="subtitle">请在小店原生页面选择规格并加入购物车。返回后点击“确认已处理”，该按钮只代表用户确认，不代表平台服务端核验。</view>
    <view class="button-row">
      <button class="secondary" bindtap="previous">上一件</button>
      <button class="primary" bindtap="confirmItem">确认已处理</button>
      <button class="secondary" bindtap="next">下一件</button>
    </view>
  </view>
  <view class="card">
    <view class="button-row">
      <button class="secondary" bindtap="pause">暂停</button>
      <button class="secondary" bindtap="resume">继续</button>
      <button class="danger" bindtap="cancel">取消</button>
    </view>
    <button class="primary" bindtap="awaitingOrder">商品已处理，进入订单核验</button>
    <button class="secondary" bindtap="progress">查看操作进度</button>
  </view>
</view>
