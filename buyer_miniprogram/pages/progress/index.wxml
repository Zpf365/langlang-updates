<view class="page">
  <view class="card">
    <view class="title">商品操作进度</view>
    <view class="muted">这里只记录用户手机操作，不代表购物车服务端成功。</view>
  </view>
  <view class="empty" wx:if="{{!events.length}}">暂无操作记录</view>
  <view class="card" wx:for="{{events}}" wx:key="event_id">
    <view class="row"><text>{{item.action}}</text><text class="status">{{item.result}}</text></view>
    <view class="muted">{{item.created_at}}</view>
  </view>
</view>
