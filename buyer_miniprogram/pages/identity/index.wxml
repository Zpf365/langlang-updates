<view class="page">
  <view class="card">
    <view class="title">买家身份已绑定</view>
    <view class="subtitle">{{identity.display_name || "微信买家"}}</view>
    <view class="muted">身份编号：{{identity.buyer_identity_id}}</view>
    <view class="button-row">
      <button class="primary" bindtap="tasks">查看商品任务</button>
      <button class="secondary" bindtap="account">账号管理</button>
    </view>
  </view>
</view>
