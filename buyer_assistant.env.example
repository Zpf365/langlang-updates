# Configure these values in Supabase Edge Function secrets.
# Never place real secrets in this file, the mini program, or Windows assets.
WECHAT_BUYER_MINI_APPID=wx0000000000000000
WECHAT_BUYER_MINI_APPSECRET=REPLACE_IN_SUPABASE_SECRETS_ONLY
WECHAT_BUYER_MINI_ENV=release
WECHAT_SHOP_APPID=REPLACE_WITH_SHOP_APPID

# Supabase injects these automatically in deployed functions.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SUPABASE_SECRETS_ONLY
